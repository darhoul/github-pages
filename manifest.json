<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>تحويل الصوت إلى نص الذكي</title>
    <style>
        :root {
            --primary-color: #2c3e50;
            --secondary-color: #3498db;
            --success-color: #27ae60;
            --danger-color: #e74c3c;
            --warning-color: #f1c40f;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
            margin: 0;
            padding: 20px;
            color: var(--primary-color);
        }

        .container {
            max-width: 800px;
            margin: 0 auto;
            background: rgba(255, 255, 255, 0.95);
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        }

        h1 {
            color: var(--primary-color);
            margin-bottom: 30px;
            font-size: 2.5em;
        }

        .button-group {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            justify-content: center;
            margin-bottom: 20px;
        }

        button {
            padding: 12px 25px;
            border: none;
            border-radius: 25px;
            cursor: pointer;
            font-weight: bold;
            transition: all 0.3s ease;
        }

        #recordButton { background: var(--success-color); color: white; }
        #recordButtonEn { background: #9b59b6; color: white; }
        #clearButton { background: var(--warning-color); color: black; }
        #copyButton { background: var(--secondary-color); color: white; }

        textarea {
            width: 100%;
            height: 200px;
            margin: 20px 0;
            padding: 15px;
            border: 2px solid #ddd;
            border-radius: 10px;
            font-size: 16px;
            line-height: 1.6;
        }

        .status-indicator {
            display: none;
            align-items: center;
            gap: 10px;
            margin: 15px 0;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>🖥️ محول الصوت إلى نص الذكي</h1>
        
        <div class="button-group">
            <button id="recordButton">🎤 تحدث عربي</button>
            <button id="recordButtonEn">🎧 تحدث إنجليزي</button>
           
        </div>

        <div class="status-indicator">
            <span>🔴 جاري التسجيل...</span>
        </div>

        <textarea id="output" placeholder="النص المترجم سيظهر هنا..."></textarea>

        <div class="button-group">
            <button id="copyButton">📋 نسخ النص</button>
            <button id="clearButton">🧹 مسح النص</button>
        </div>

        <video id="mediaPlayer" controls style="display:none; width:100%"></video>
    </div>

    <script>
        const recordButton = document.getElementById("recordButton");
        const recordButtonEn = document.getElementById("recordButtonEn");
        const output = document.getElementById("output");
        const fileInput = document.getElementById("fileInput");
        const mediaPlayer = document.getElementById("mediaPlayer");
        const statusIndicator = document.querySelector(".status-indicator");

        let recognitionAr = new (window.SpeechRecognition || window.webkitSpeechRecognition)();
        let recognitionEn = new (window.SpeechRecognition || window.webkitSpeechRecognition)();

        recognitionAr.lang = 'ar-SA';
        recognitionEn.lang = 'en-US';
        
        let isRecordingAr = false;
        let isRecordingEn = false;
        
        function toggleRecognition(recognition, isRecording, lang) {
            if (isRecording) {
                recognition.stop();
                statusIndicator.style.display = "none";
                isRecording = false;
            } else {
                if (!recognition.running) {
                    recognition.start();
                    statusIndicator.style.display = "flex";
                    isRecording = true;
                }
            }
        }

        recognitionAr.onresult = event => {
            output.value = Array.from(event.results).map(result => result[0].transcript).join('\n');
        };

        recognitionEn.onresult = event => {
            output.value = Array.from(event.results).map(result => result[0].transcript).join('\n');
        };

        recordButton.addEventListener("click", () => toggleRecognition(recognitionAr, isRecordingAr, 'ar'));
        recordButtonEn.addEventListener("click", () => toggleRecognition(recognitionEn, isRecordingEn, 'en'));

        fileInput.addEventListener("change", event => {
            const file = event.target.files[0];
            if (file) {
                const url = URL.createObjectURL(file);
                mediaPlayer.src = url;
                mediaPlayer.style.display = "block";
            }
        });

        document.getElementById("copyButton").addEventListener("click", () => {
            output.select();
            document.execCommand("copy");
            alert("تم نسخ النص!");
        });

        document.getElementById("clearButton").addEventListener("click", () => {
            output.value = "";
        });
    </script>
</body>
</html>
